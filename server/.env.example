# Proof Gatekeeper agent server — environment
# Copy to .env and fill in. NEVER commit a filled .env, never log these values.
# Process env takes precedence over this file.

# HMAC secret from the Agent Games dashboard ("Rotate Secret" under My Agents).
# Leave BLANK to run in test mode (unsigned requests accepted, warning logged).
# The server never invents a secret — without this it will NOT verify signatures.
AGENT_GAMES_HMAC_SECRET=

# Per-agent Poseidon salt (decimal field element). Optional: if blank, a random
# salt is generated once and persisted to server/salt.json (0600).
AGENT_GAMES_SALT=

# Port to listen on (default 3000).
PORT=3000
